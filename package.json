{
  "name": "barcelona-atlas",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && .venv/bin/python -m unittest discover -s tests -p \"test_*.py\"",
    "data:refresh": "python3 scripts/import_data.py",
    "test:e2e": "playwright test",
    "dev:web": "vite --host 0.0.0.0",
    "start": ".venv/bin/python -m uvicorn server.app:app --host 127.0.0.1 --port 8000",
    "setup:api": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "catalog:refresh": ".venv/bin/python -m scripts.sync_catalog",
    "r2:publish": ".venv/bin/python -m scripts.r2_assets",
    "r2:verify": ".venv/bin/python -m scripts.r2_verify",
    "r2:mirror": ".venv/bin/python -m scripts.r2_mirror",
    "check:worker": "tsc -p tsconfig.worker.json",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "wrangler deploy",
    "check:deploy": "wrangler deploy --dry-run --containers-rollout=none --outdir .cache/worker-build",
    "catalog:curate": ".venv/bin/python -m scripts.curate_catalog",
    "spatial:build": ".venv/bin/python -m scripts.build_spatial_reference",
    "analytics:extract": "OPENBLAS_NUM_THREADS=1 .venv/bin/python -m scripts.analytics.extract",
    "analytics:build": "OPENBLAS_NUM_THREADS=4 .venv/bin/python -m scripts.analytics.analyse",
    "analytics:publish": ".venv/bin/python -m scripts.analytics.publish"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.1.0",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=22"
  }
}
