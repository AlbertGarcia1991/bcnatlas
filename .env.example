# Server only: configure these on the host, never as VITE_* variables.
BCN_DATA_SOURCE=r2
BCN_R2_RAW_BUCKET=bcn-atlas-raw
BCN_R2_PUBLIC_BUCKET=bcn-atlas-public
BCN_R2_RAW_PREFIX=snapshots/initial-2026-11-07
BCN_R2_APP_PREFIX=app/v1.2.0
CLOUDFLARE_R2_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_ACCESS_KEY_SECRET=
# Optional after custom domain + CORS are verified:
# VITE_DATA_BASE_URL=https://data.bcnatlas.com/app/v1.2.0/data
# Omit the VITE setting to use the same-origin API, which reads from R2.
