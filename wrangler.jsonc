{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bcnatlas",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "r2_buckets": [{ "binding": "PUBLIC_DATA", "bucket_name": "bcn-atlas-public" }],
  "vars": {
    "BCN_R2_APP_PREFIX": "app/v1.2.0",
    "BCN_R2_RAW_PREFIX": "snapshots/initial-2026-11-07",
    "BCN_R2_RAW_BUCKET": "bcn-atlas-raw",
    "BCN_R2_PUBLIC_BUCKET": "bcn-atlas-public"
  },
  "containers": [{
    "class_name": "AtlasApi",
    "image": "./Dockerfile",
    "instance_type": "standard-1",
    "max_instances": 1
  }],
  "durable_objects": { "bindings": [{ "name": "ATLAS_API", "class_name": "AtlasApi" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AtlasApi"] }],
  "ratelimits": [{ "name": "PREVIEW_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "observability": { "enabled": true }
}
